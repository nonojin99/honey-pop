; 허니 팝 (honey-pop) — Godot 4.7
;
; Puzzle Bobble 계열. 육각 격자를 벌집 세계관으로 그대로 쓴다.
; 2축: 조준 정밀도(축1) × 꽃가루 게이지(축2). 수식은 scripts/difficulty.gd 가 유일한 원천.
;
; 목표 플랫폼: Web(HTML5) + Android. iOS 는 빌드 시점에 macOS 가 필요하다(README).

config_version=5

[application]

config/name="허니 팝"
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Game="*res://scripts/game_state.gd"
Sfx="*res://scripts/audio.gd"
Net="*res://scripts/net.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
; 데스크톱 확인용 창 — 실제 폰 비율(9:19.5). 16:9 로 두면 발사대가 화면 밖으로 밀린다
window/size/window_width_override=405
window/size/window_height_override=877
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

; 데스크톱 마우스도 터치로 받는다 — 조준 드래그를 한 경로로 처리한다
pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/canvas_textures/default_texture_filter=1
